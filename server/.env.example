# Business Logic Durations & Limits
HOLD_SECONDS=180
PAYMENT_SECONDS=60
MAX_TICKETS_PER_USER=10
MAX_PAYMENT_ATTEMPTS=3
MAX_OTP_ATTEMPTS=3
QUEUE_MAX_ACTIVE=100
QUEUE_ADMISSION_SECONDS=300
VENUE_TURNOVER_MINUTES=180

