# Copy to .env and fill in. Never commit .env.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_API_URL=http://localhost:8080
# true = pages use local fixtures from src/mocks (no backend needed)
VITE_USE_MOCKS=true
# Role of the fake signed-in user when VITE_USE_MOCKS=true: customer | organiser
VITE_MOCK_ROLE=customer
